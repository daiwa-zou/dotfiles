# Path configuration (customize if needed)
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export PATH=$PATH:$(go env GOPATH)/bin

# Path to your Oh My Zsh installation
export ZSH=$HOME/.oh-my-zsh

# Path to the dotfiles directory
export DOTFILES=$HOME/.dotfiles

# Set Golang private repo
export GOPRIVATE=github.com/InfraFlux/*,github.com/daiwa-zou/*

# Source environment variables from ~/.localrc if it exists
if [[ -f ~/.localrc ]]; then
  source ~/.localrc
fi

# Load Oh My Zsh theme and plugins
ZSH_THEME="linuxonly"

# Zsh plugins
plugins=(
  git
  git-auto-fetch
  git-commit
  colored-man-pages
  brew
  hitchhiker
  colorize
  common-aliases
  extract
  tmux
  fancy-ctrl-z
  golang
  rust
)

# Initialize Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Collect all zsh configuration files from the dotfiles directory
typeset -U config_files
config_files=($DOTFILES/**/*.zsh)

# Load path configuration files
for file in ${(M)config_files:#*/path.zsh}; do
  source "$file"
done

# Load all other zsh configuration files except path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}; do
  source "$file"
done

# Add Docker Desktop completions to fpath before compinit
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# Initialize autocomplete
autoload -U compinit
compinit

# Load completion files after autocomplete is initialized
for file in ${(M)config_files:#*/completion.zsh}; do
  source "$file"
done

# Clear the config_files array
unset config_files

# Set your preferred editor
export EDITOR='nvim'

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

zstyle ':omz:update' mode auto

ENABLE_CORRECTION="true"
ZSH_TMUX_DEFAULT_SESSION_NAME="workspace"

# Hitchhicker cowsay message
if command -v hitchhiker_cow > /dev/null 2>&1; then
    hitchhiker_cow
fi
